# Port of the widget server
PORT=3003

# Optional: Claude mode. Without a key the widget runs in demo mode (keyword search over the FAQ).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# CHAT_MODE=demo            # forces demo mode even if a key is set

# Allowed websites (CORS), comma-separated. "*" allows all.
ALLOWED_ORIGINS=*

# Optional: email delivery of "Talk to a person" requests. Without SMTP they're stored in data/handoffs.jsonl.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SUPPORT_EMAIL=help@your-company.example
# MAIL_FROM=chat-widget@your-company.example
